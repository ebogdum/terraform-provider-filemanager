## Authentication and Configuration

### Local Filesystem

No authentication required. The provider uses the local filesystem by default.

### SSH/SFTP Backend

```hcl
resource "filemanager_ssh_service" "server" {
  name        = "webserver"
  host        = "server.example.com"
  port        = 22
  user        = "deploy"
  private_key = file("~/.ssh/id_rsa")
}

resource "filemanager_file" "remote_config" {
  path    = "/etc/app/config.json"
  content = jsonencode({ key = "value" })
  service = filemanager_ssh_service.server.name
}
```

### S3-Compatible Storage

```hcl
resource "filemanager_s3_service" "bucket" {
  name       = "my-bucket"
  bucket     = "my-terraform-files"
  region     = "us-east-1"
  access_key = var.aws_access_key
  secret_key = var.aws_secret_key
}

resource "filemanager_upload" "config" {
  source      = "local/config.json"
  destination = "configs/app.json"
  service     = filemanager_s3_service.bucket.name
}
```

